generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FriendRequestStatus {
  PENDING
  REJECTED

  @@map("friend_request_status")
}

enum PlanPhase {
  ACTIVE
  BALANCE
  COMPLETED

  @@map("plan_phase")
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  LODGING
  ENTERTAINMENT
  SHOPPING
  HEALTH
  SERVICES
  OTHER

  @@map("expense_category")
}

enum PaymentKind {
  TRANSFER
  MANUAL_CLOSE

  @@map("payment_kind")
}

model User {
  id                 String   @id @default(cuid())
  clerkUserId        String   @unique @map("clerk_user_id")
  email              String   @unique
  name               String
  username           String   @unique
  usernameNormalized String   @unique @map("username_normalized")
  phone              String   @unique
  bankName           String?  @map("bank_name")
  cci                String?
  accountNumber      String?  @map("account_number")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  friendRequestsSent     FriendRequest[] @relation("FriendRequestFrom")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestTo")
  friendshipsAsLow       Friendship[]    @relation("FriendshipLow")
  friendshipsAsHigh      Friendship[]    @relation("FriendshipHigh")
  createdPlans           Plan[]          @relation("PlanCreator")
  planMemberships        PlanMember[]
  recordedPayments       Payment[]       @relation("PaymentRecordedBy")

  @@map("users")
}

model FriendRequest {
  id         String               @id @default(cuid())
  fromUserId String               @map("from_user_id")
  toUserId   String               @map("to_user_id")
  status     FriendRequestStatus
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  fromUser User @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@map("friend_requests")
}

model Friendship {
  id         String   @id @default(cuid())
  userLowId  String   @map("user_low_id")
  userHighId String   @map("user_high_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  userLow  User @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@map("friendships")
}

model Plan {
  id            String          @id @default(cuid())
  name          String
  icon          ExpenseCategory
  phase         PlanPhase       @default(ACTIVE)
  creatorUserId String          @map("creator_user_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  creator  User         @relation("PlanCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  members  PlanMember[]
  expenses Expense[]
  payments Payment[]

  @@index([creatorUserId])
  @@index([phase])
  @@index([createdAt])
  @@map("plans")
}

model PlanMember {
  id                   String   @id @default(cuid())
  planId               String   @map("plan_id")
  userId               String?  @map("user_id")
  ghostName            String?  @map("ghost_name")
  ghostNameNormalized  String?  @map("ghost_name_normalized")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  plan           Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  paidExpenses   Expense[]      @relation("ExpensePaidBy")
  expenseShares  ExpenseShare[]
  paymentsFrom   Payment[]      @relation("PaymentFrom")
  paymentsTo     Payment[]      @relation("PaymentTo")

  @@unique([planId, userId])
  @@unique([planId, ghostNameNormalized])
  @@index([planId])
  @@index([userId])
  @@map("plan_members")
}

model Expense {
  id             String           @id @default(cuid())
  planId         String           @map("plan_id")
  title          String
  amount         Decimal          @db.Decimal(12, 2)
  category       ExpenseCategory
  paidByMemberId String           @map("paid_by_member_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  plan         Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  paidByMember PlanMember     @relation("ExpensePaidBy", fields: [paidByMemberId], references: [id], onDelete: Restrict)
  shares       ExpenseShare[]

  @@index([planId])
  @@map("expenses")
}

model ExpenseShare {
  id          String   @id @default(cuid())
  expenseId   String   @map("expense_id")
  memberId    String   @map("member_id")
  shareAmount Decimal  @db.Decimal(12, 2) @map("share_amount")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  expense Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  PlanMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([expenseId, memberId])
  @@map("expense_shares")
}

model Payment {
  id                 String      @id @default(cuid())
  planId             String      @map("plan_id")
  fromMemberId       String      @map("from_member_id")
  toMemberId         String      @map("to_member_id")
  amount             Decimal     @db.Decimal(12, 2)
  recordedByUserId   String      @map("recorded_by_user_id")
  kind               PaymentKind
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  plan           Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  fromMember     PlanMember @relation("PaymentFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember       PlanMember @relation("PaymentTo", fields: [toMemberId], references: [id], onDelete: Restrict)
  recordedByUser User       @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@map("payments")
}
